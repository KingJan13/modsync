{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModSync",
  "version": "0.1.0",
  "identifier": "com.modsync.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ModSync",
        "width": 1180,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}